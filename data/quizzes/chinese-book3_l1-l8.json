321","type":0,"prompt":"就作者摹寫的手法而言，何者貫穿車過枋寮全篇？","choices":["甘甜","圓渾","鹹苦","廣闊"],"answerIndex":0,"image":null},{"id":"322","type":0,"prompt":"下列「」中的詞語，何者不是狀聲詞？","choices":["「嗤嗤」價響","「格格」價飛","「呱呱」噪啼","「躍躍」欲試"],"answerIndex":3,"image":null},{"id":"323","type":0,"prompt":"「比行百里」中的「比」字，其讀音與下列何者不同？","choices":["鱗次櫛「比」","今非昔「比」","「比比」皆是","朋「比」為奸"],"answerIndex":1,"image":null},{"id":"324","type":0,"prompt":"下列各選項中的詞語，何者用字錯誤？","choices":["清新真摯","著書立說","從容不迫","溥衍了事"],"answerIndex":3,"image":null}]}