ex":1,"image":null},{"id":"229","type":0,"prompt":"慈烏夜啼一詩中，何句是責備的語氣？","choices":["百鳥豈無母，爾獨哀怨深","應是母慈重，使爾悲不任","夜夜夜半啼，聞者為沾襟","嗟哉斯徒輩，其心不如禽"],"answerIndex":3,"image":null},{"id":"230","type":0,"prompt":"「香遠益清，亭亭淨植」暗示君子具有哪一種德性？","choices":["隱逸脫俗，獨善其身","德性芬芳，人格高潔","剛毅正直，一介不取","端方正直，休休有容"],"answerIndex":1,"image":null},{"id":"231","type":0,"prompt":"打開全唐詩，可能找不到下列哪一篇作品？","choices":["山居秋暝","楓橋夜泊","黃鶴樓送孟浩然之廣陵","庭中有奇樹"],"answerIndex":3,"image":null},{"id":"232","type":0,"prompt":"下列何者是古代君王對臣下的稱呼？","choices":["卿","陛下","朕","寡人"],"answerIndex":0,"image":null},{"id":"233","type":0,"prompt":"下列選項中的「金」字，何者是實指顏色？","choices":["金城湯池","金科玉條","披沙揀金","碧眼金髮"],"answerIndex":3,"image":null},{"id":"234","type":0,"prompt":"下列「」中的字，何者並非通同字？","choices":["可愛者甚「蕃」：繁","徐以「杓」酌油瀝之：勺","日「啗」芻豆數斗：啖","「予」獨愛蓮：於"],"answerIndex":3,"image":null},{"id":"235","type":0,"prompt":"宗憲參加演講比賽得到優勝，奬盃上應該題上下列何者？","choices":["巧言令色","舌粲蓮花","期期艾艾","口角春風"],"answerIndex":1,"image":null},{"id":"236","type":0,"prompt":"下列選項中的成語，何者是愛蓮說中的「花之君子者」所表現的美德？","choices":["任重道遠","冰清玉潔","時窮節現","從容就義"],"answerIndex":1,"image":null},{"id":"237","type":0,"prompt":"老師要傑輪選出意思相近的一組成語，應該是下列何者？","choices":["勢均力敵／並駕齊驅","心安理得／虛懷若谷","不息不汗／力竭汗喘","力裕不逞／鋒芒畢露"],"answerIndex":0,"image":null},{"id":"238","type":0,"prompt":"下列哪一個詩句和「一行白鷺上青天」同樣具有色彩美與動態感？","choices":["三更畫舫穿藕花","一城山色半城湖","四面荷花三面柳","一盞寒泉薦秋菊"],"answerIndex":0,"image":null},{"id":"239","type":0,"prompt":"「從此地到山麓，／一大幅平原舉起／多少甘蔗」句中表達了何種訊息？","choices":["屏東種植甘蔗面積廣大","屏東路途遙遠","屏東平原的地形起伏","屏東的甘蔗莖葉繁茂"],"answerIndex":0,"image":null},{"id":"240","type":0,"prompt":"下列「」中量詞的使用，何者錯誤？","choices":["一「介」平民","一「匹」布帛","一「桿」芻豆","一「簇」紅霞"],"answerIndex":2,"image":null},{"id":"241","type":0,"prompt":"下列哪個「以」字的用法，與「不幸相繼以死」的「以」一樣？","choices":["「以」叢草為林","無求生「以」害仁","君子「以」文會友","君子不「以」言舉人"],"answerIndex":1,"image":null},{"id":"242","type":0,"prompt":"下列各詩體，何者是白居易不可能會創作的？","choices":["新詩","絕句","律詩","樂府詩"],"answerIndex":0,"image":null},{"id":"243","type":0,"prompt":"下列哪一組成語，用字完全正確？","choices":["膽魄魂奪","雷霆萬鈞","迫在眉截","章牙舞爪"],"answerIndex":1,"image":null},{"id":"244","type":0,"prompt":"下列「」中的字，何者讀音正確？","choices":["「璀」璨：ㄔㄨㄟˇ","簡「窳」：ㄩˊ","「滲」透：ㄕㄣˋ","路「畔」：ㄅㄢˋ"],"answerIndex":2,"image":null},{"id":"245","type":0,"prompt":"「一盞寒泉薦秋菊，三更畫舫穿藕花」這副對聯中，共有幾個動詞？","choices":["一個","二個","三個","四個"],"answerIndex":1,"image":null},{"id":"246","type":0,"prompt":"下列成語，何者不能用來形容氣勢「雄偉壯盛」？","choices":["氣勢萬鈞","風起雲湧","勢均力敵","勢如山倒"],"answerIndex":2,"image":null},{"id":"247","type":0,"prompt":"車過枋寮詩中經常出現的「牧神」，是取自何處的神話人物？","choices":["印度","中國","希臘","羅馬"],"answerIndex":2,"image":null},{"id":"248","type":0,"prompt":"「上」字的造字方式與下列何者相同？","choices":["文","自","如","本"],"answerIndex":3,"image":null},{"id":"249","type":0,"prompt":"「心腹之語」之於「肺腑之言」，猶如「篳路襤褸」之於下列何者？","choices":["創業維艱","衣衫襤褸","窮途末路","綺襦紈褲"],"answerIndex":0,"image":null},{"id":"250","type":0,"prompt":"「三更畫舫穿藕花」的季節，與下列何者相同？","choices":["煙花三月下揚州","瑤琴一曲來薰風","梨花新折東風軟","纔有梅花便不同"],"answerIndex":1,"image":null},{"id":"251","type":0,"prompt":"下列做事的態度，何者與其他三者不同？","choices":["不拘小節","虛應故事","馬馬虎虎","敷衍塞責"],"answerIndex":0,"image":null},{"id":"252","type":0,"prompt":"「在荒野中遇到幾回」句中的「回」字不可用下列何者替換？","choices":["次","株","遭","遍"],"answerIndex":1,"image":null},{"id":"253","type":0,"prompt":"田園之秋選一文以人的渺小來顯現大自然的偉大，這種修辭技巧稱為什麼？","choices":["譬喻","倒反","借代","映襯"],"answerIndex":3,"image":null},{"id":"254","type":0,"prompt":"下列「」中字義的解釋，何者錯誤？","choices":["「咫」尺：八寸","「攫」來：抓取","「酷」愛：非常","「逞」英雄：表示"],"answerIndex":3,"image":null},{"id":"255","type":0,"prompt":"下列「」中的字，何者是動詞？","choices":["「介」而馳","「比」行百里","受大而不「苟」取","初不「甚」疾"],"answerIndex":0,"image":null},{"id":"256","type":0,"prompt":"古代以十二地支來計時，若小丸子預定晚上六點看電影，她必須幾時到達？","choices":["午時","卯時","戌時","酉時"],"answerIndex":3,"image":null},{"id":"257","type":0,"prompt":"「葡萄園裡，滿架都是□□的果實」缺空處宜填入下列何者？","choices":["漫漫","落落","纍纍","壘壘"],"answerIndex":2,"image":null},{"id":"258","type":0,"prompt":"田園之秋選一文中，作者用了許多物象來比喻烏雲，不包括下列何者？","choices":["黑怪","惡魔","主宰","妖巫"],"answerIndex":2,"image":null},{"id":"259","type":0,"prompt":"慈烏夜啼一詩中，未述及何種內容？","choices":["敘事","寫景","抒情","議論"],"answerIndex":1,"image":null},{"id":"260","type":0,"prompt":"下列哪一組詞語的意思不能相通？","choices":["蘇醒／甦醒","盤旋／旋繞","酷愛／極愛","黑壓壓／沉甸甸"],"answerIndex":3,"image":null},{"id":"261","type":0,"prompt":"「無的放矢」的「的」字，其用法與下列何者相同？","choices":["正中鵠「的」","我「的」書","「的」確如此","火紅「的」太陽"],"answerIndex":0,"image":null},{"id":"262","type":0,"prompt":"下列詞語，何者用字完全正確？","choices":["點掇其中","枉開一面","貿險進取","急流勇退"],"answerIndex":3,"image":null},{"id":"263","type":0,"prompt":"「慈烏失其母」的傷痛之情，可用下列哪個詞語形容最恰當？","choices":["風木之思","舐犢之愛","西河之痛","鼓盆之戚"],"answerIndex":0,"image":null},{"id":"264","type":0,"prompt":"下列「」中的字，何者讀音正確？","choices":["「崎」嶇不平：ㄑㄧ","「縱」橫錯綜：ㄗㄨㄥ","「蜿」蜒綿長：ㄨㄢˇ","無「垠」無涯：ㄏㄣˊ"],"answerIndex":1,"image":null},{"id":"265","type":0,"prompt":"車過枋寮一詩中，下列何者表現出甘蔗紛披，莖鬚如髯的情景？","choices":["長途車駛不出牧神的轄區","青青的儀隊","多毛又多鬚","在哪一株甘蔗下午睡"],"answerIndex":2,"image":null},{"id":"266","type":0,"prompt":"下列「」中的字，何者詞性與其他三者不同？","choices":["我「酷」愛這一帶旱地","「盡」向地面攫來","「愈」來愈遠","肆虐不「已」"],"answerIndex":3,"image":null},{"id":"267","type":0,"prompt":"下列成語，何者用字完全正確？","choices":["盤根錯結","默默無聞","蹈常席故","浩翰無垠"],"answerIndex":1,"image":null},{"id":"268","type":0,"prompt":"下列何者讀音正確？","choices":["「攫」來：ㄐㄩㄝˊ","震「懾」：ㄕㄜˋ","匍匐：ㄆㄨˊㄊㄠˊ","行潦：ㄏㄤˊㄌㄧㄠˊ"],"answerIndex":0,"image":null},{"id":"269","type":0,"prompt":"從「更有一株半株的丹楓夾在裡面」可以看出老殘是在哪一個季節遊大明湖？","choices":["春季","夏季","秋季","冬季"],"answerIndex":2,"image":null},{"id":"270","type":0,"prompt":"以植物象徵人的特性或品格，下列何者搭配不恰當？","choices":["蘇軾／竹","王冕／蘭","陶淵明／菊","林和靖／梅"],"answerIndex":1,"image":null},{"id":"271","type":0,"prompt":"下列「」中的詞語，何者的字是可以各自獨立成詞的？","choices":["「匍匐」前進","「霹靂」閃電","「肆虐」不已","「逍遙」自在"],"answerIndex":2,"image":null},{"id":"272","type":0,"prompt":"下列形似字的運用，何者正確？","choices":["毫無遮「避」","貪汙舞「幣」","「敝」帚自珍","暴「弊」身亡"],"answerIndex":2,"image":null},{"id":"273","type":0,"prompt":"下列選項中的詞語結構，何者和「天昏地暗」相同？","choices":["沾泥帶水","上行下效","窗明几淨","守株待兔"],"answerIndex":2,"image":null},{"id":"274","type":0,"prompt":"下列哪一個「然」字，與「若無事然」的「然」字意思相同？","choices":["豁「然」開朗","「然」非精潔即不受","「然」！是也","古之人皆「然」"],"answerIndex":0,"image":null},{"id":"275","type":0,"prompt":"「天昏地暗」之於「晴空萬里」，猶如「張牙舞爪」之於下列何者？","choices":["橫行霸道","齜牙咧嘴","耀武揚威","和藹可親"],"answerIndex":3,"image":null},{"id":"276","type":0,"prompt":"「光明坦蕩」之於「嶔崎磊落」，猶如「風物習俗」之於下列何者？","choices":["山川地理","物產豐饒","風土民情","簡窳不文"],"answerIndex":2,"image":null},{"id":"277","type":0,"prompt":"大明湖一文中，下列哪一句是描寫濟南市全市的景觀？","choices":["四面荷花三面柳","一城山色半城湖","濟南名士多","三更畫舫穿藕花"],"answerIndex":1,"image":null},{"id":"278","type":0,"prompt":"下列何者不是同義複詞？","choices":["擦拭","渾圓","甘甜","希冀"],"answerIndex":1,"image":null},{"id":"279","type":0,"prompt":"「義存扶漢三分鼎／志在平金一片心」這副對聯應該是歌詠哪兩個人？","choices":["岳飛、張飛","項羽、關羽","關羽、岳飛","孔明、項羽"],"answerIndex":2,"image":null},{"id":"280","type":0,"prompt":"「傳家有道唯存厚／處世無奇但率真」這副對聯最適合貼在哪裡？","choices":["廚房","臥室","花園","大門"],"answerIndex":3,"image":null},{"id":"281","type":0,"prompt":"下列「」中的詞義，何者與其他三者不同？","choices":["使爾悲「不任」","「不禁」淚流滿面","兩岸猿聲啼「不住」","高處「不勝」寒"],"answerIndex":2,"image":null},{"id":"282","type":0,"prompt":"下列何項「」中的字不可用後面的字替換？","choices":["濯清漣而不「妖」：夭","陶後「鮮」有聞：少","「予」謂：余","香遠「益」清：愈"],"answerIndex":0,"image":null},{"id":"283","type":0,"prompt":"田園之秋選一文的作者記錄當天的生活情景，是以何種物象來貫串全文？","choices":["摘番薯蒂","大西北雨","貝多芬田園交響曲","石灰地質的田地"],"answerIndex":1,"image":null},{"id":"284","type":0,"prompt":"「一路秋山紅葉，老圃黃花」，句中「黃花」指的是下列何者？","choices":["菊花","枯萎的花","黃葉","山花"],"answerIndex":0,"image":null},{"id":"285","type":0,"prompt":"下列「」中的字，何者詞性與其他三者不同？","choices":["不幸相繼「以」死","徐噴「以」煙","君子不「以」言舉人","自古「以」來"],"answerIndex":0,"image":null},{"id":"286","type":0,"prompt":"下列各詞何者意思與其他三者不同？","choices":["梵宇","寺院","古剎","驛站"],"answerIndex":3,"image":null},{"id":"287","type":0,"prompt":"下列何者不是用來形容君子高尚的美德？","choices":["前倨後恭","光風霽月","嶔崎磊落","行不由徑"],"answerIndex":0,"image":null},{"id":"288","type":0,"prompt":"「霹靂」一詞的聲音關係為疊韻，下列詞語何者的聲音關係與「霹靂」相同？","choices":["盤旋","流連","彷彿","震懾"],"answerIndex":0,"image":null},{"id":"289","type":0,"prompt":"漢字中形聲字是數量最多的下列各組何者全部都是形聲字？","choices":["日／幣","斃／駑","馬／豆","材／取"],"answerIndex":1,"image":null},{"id":"290","type":0,"prompt":"車過枋寮一詩中，「檢閱牧神青青的儀隊」是用來描寫什麼？","choices":["西瓜田","香蕉田","甘蔗田","椰子樹"],"answerIndex":2,"image":null},{"id":"291","type":0,"prompt":"下列「」中的詞語，何者不是指「長度」單位？","choices":["千「鈞」一髮","「咫」尺天涯","為山九「仞」","月殿聳千「尋」"],"answerIndex":0,"image":null},{"id":"292","type":0,"prompt":"「寡取易盈」的「寡取」是呼應前面哪句話？","choices":["日不過數升","攬轡未安，踴躍疾驅","甫百里，力竭汗喘","秣不擇粟，飲不擇泉"],"answerIndex":0,"image":null},{"id":"293","type":0,"prompt":"下列何項是用來形容「劣馬」？","choices":["攬轡未安，踴躍疾驅","日啗芻豆數斗，飲泉一斛","受大而不苟取","比行百里，始奮迅"],"answerIndex":0,"image":null},{"id":"294","type":0,"prompt":"下列何者讀音正確？","choices":["「驍」勇善戰：ㄖㄠˊ","「驀」然回首：ㄇㄨˋ","白「駒」過隙：ㄐㄩ","驚濤「駭」浪：ㄏㄞˊ"],"answerIndex":2,"image":null},{"id":"295","type":0,"prompt":"在愛蓮說的文句中，下列何者表現了鄙夷的口氣？","choices":["菊，花之隱逸者也","牡丹之愛，宜乎眾矣","香遠益清，亭亭淨植","中通外直，不蔓不枝"],"answerIndex":1,"image":null},{"id":"296","type":0,"prompt":"下列「」中的字代換後，何者意思改變了？","choices":["「甦」醒／蘇","不亦「說」乎／悅","「矢」勤矢勇／使","孤「伶伶」／零零"],"answerIndex":2,"image":null},{"id":"297","type":0,"prompt":"大明湖一文，作者極力描寫的是哪裡的景色？","choices":["濟南府","千佛山","歷下亭","水仙祠"],"answerIndex":1,"image":null},{"id":"298","type":0,"prompt":"下列何者的含義與「受大而不苟取」最接近？","choices":["簞瓢屢空","實事求是","寧缺勿濫","囫圇吞棗"],"answerIndex":2,"image":null},{"id":"299","type":0,"prompt":"小傑要作「現代散文研究」的報告，哪一位作家的作品不宜收錄其中？","choices":["艾雯","劉墉","岳飛","宋晶宜"],"answerIndex":2,"image":null},{"id":"300","type":0,"prompt":"下列「」中的字，何者詞性前後不同？","choices":["「孵」出／「砌」成","「檢」閱／「正」說","「寶」庫／「甘」美","山「麓」／多「鬚」"],"answerIndex":1,"image":null},{"id":"301","type":0,"prompt":"唐代詩人中，主張「文章合為時而著，歌詩合為事而作」的是哪一位？","choices":["杜甫","李白","白居易","李商隱"],"answerIndex":2,"image":null},{"id":"302","type":0,"prompt":"下列各組詞語的關係，何者與其他三者不同？","choices":["張牙舞爪／耀武揚威","近在咫尺／天南地北","膽破魂奪／鎮定自若","天昏地暗／風和日麗"],"answerIndex":0,"image":null},{"id":"303","type":0,"prompt":"「日啗芻豆數斗，飲泉一斛，然非精潔即不受」這段話可以象徵怎樣的人？","choices":["居心叵測","守正不阿","才高八斗","菽水承歡"],"answerIndex":1,"image":null},{"id":"304","type":0,"prompt":"下列詞語「」中的量詞，何者使用錯誤？","choices":["一「件」佛像","為五「斗」米折腰","一「幢」華廈","兩「盞」淡酒"],"answerIndex":0,"image":null},{"id":"305","type":0,"prompt":"下列何者用字完全正確？","choices":["莫莫無聞／四通八達","平空杜撰／初出茅廬","傾家蕩