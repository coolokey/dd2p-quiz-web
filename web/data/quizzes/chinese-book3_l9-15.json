e":null},{"id":"076","type":0,"prompt":"下列何者未使用敬詞？","choices":["證嚴上人開示民眾","老衲即將前往南海","請你移駕至總經理室","閣下務必參加餐宴"],"answerIndex":1,"image":null},{"id":"077","type":0,"prompt":"「幽默」一詞是從英文ｈｕｍｏｕｒ音譯而來，下列哪一個詞語亦是如此？","choices":["靚妹","八卦","沙發","機車"],"answerIndex":2,"image":null},{"id":"078","type":0,"prompt":"「此樂非但忘貧，兼可入道」，李慈銘所謂的「此樂」與下列何者性質相同？","choices":["金榜題名時之樂","他鄉遇故知之樂","洞房花燭夜之樂","晝長吟罷蟬鳴樹之樂"],"answerIndex":3,"image":null},{"id":"079","type":0,"prompt":"下列解釋何者錯誤？","choices":["陶冶：塑造化育","謙遜：辦事不力","策勵：督責勉勵","駕馭：控制指揮"],"answerIndex":1,"image":null},{"id":"080","type":0,"prompt":"下列何者不是實詞？","choices":["副詞","動詞","助詞","代詞"],"answerIndex":2,"image":null},{"id":"081","type":0,"prompt":"下列「」中的量詞，何者運用最正確？","choices":["一「副」掛圖","一「盞」明燈","一「根」飯","一「張」對聯"],"answerIndex":1,"image":null},{"id":"082","type":0,"prompt":"下列有關詞的別稱，何者錯誤？","choices":["副詞：限制詞","介詞：介繫詞","連詞：語氣詞","代詞：指稱詞"],"answerIndex":2,"image":null},{"id":"083","type":0,"prompt":"有關為學一首示子姪一文的論證方式，何者正確？","choices":["正論反論結論","例證立論結論","立論例證結論","反論正論例證"],"answerIndex":2,"image":null},{"id":"084","type":0,"prompt":"下列哪一個「字」的作用等於「詞」的作用？","choices":["萄","小","琵","螳"],"answerIndex":1,"image":null},{"id":"085","type":0,"prompt":"下列哪一種修養是麥帥為子祈禱文中沒有提到的？","choices":["謙遜","勇敢","果決","誠實"],"answerIndex":2,"image":null},{"id":"086","type":0,"prompt":"「使他可以永遠記住真實偉大的樸實無華」以下何者的功勞最符合這個特色？","choices":["民族英雄","戰無不勝的將軍","國父孫中山先生","清道婦"],"answerIndex":3,"image":null},{"id":"087","type":0,"prompt":"下列何者和「他的表情十分嚴肅」一句的句型相同？","choices":["活力充沛的感覺真好","植物能帶給人們好心情","我們只有那貧瘠的田地","擁有健康才是最大的幸福"],"answerIndex":0,"image":null},{"id":"088","type":0,"prompt":"下列哪一個選項中詞語的對應關係，和其他三者不同？","choices":["神凝意定／心有旁騖","閒雲野鶴／梅妻鶴子","無垠無涯／一望無際","橫陳屏阻／重巒疊嶂"],"answerIndex":0,"image":null},{"id":"089","type":0,"prompt":"下列「」中的字詞，何者不是指綠色？","choices":["「翠」玉","「碧」海","「緇」衣","「縹」青"],"answerIndex":2,"image":null},{"id":"090","type":0,"prompt":"相傳中國最早整理文字的人，為下列何人？","choices":["黃帝","倉頡","李斯","周文王"],"answerIndex":1,"image":null},{"id":"091","type":0,"prompt":"下列各組「」中的字，何者字音前後相同？","choices":["「姪」女／人「質」","「闡」述／「單」先生","翻「覆」／剛「愎」","透「澈」／南轅北「轍」"],"answerIndex":3,"image":null},{"id":"092","type":0,"prompt":"下列各組詞語，何組關係與其他三組不同？","choices":["垂頭喪氣／意興風發","勢單力薄／一呼百諾","漫不經心／專心致志","栩栩如生／躍然紙上"],"answerIndex":3,"image":null},{"id":"093","type":0,"prompt":"下列何者並非通同字？","choices":["作花甚「繁」／蕃","何必名山吾廬「邪」／耶","此亦「余」之三友也／予","徙「倚」其下／移"],"answerIndex":3,"image":null},{"id":"094","type":0,"prompt":"下列「」中的字，何者為虛詞？","choices":["「天」從人願","何謂「也」","他望車外看了「看」","我感謝面前的祖父「母」"],"answerIndex":1,"image":null},{"id":"095","type":0,"prompt":"「以上諸點」的「諸」字，用法與下列何者不同？","choices":["告「諸」往而知來者","「諸」多不便","緬懷「諸」先烈","「諸」位女士先生"],"answerIndex":0,"image":null},{"id":"096","type":0,"prompt":"下列哪一選項未用到嘆詞？","choices":["哇！這麼冷","你走吧","啊！好像棋盤似的","嗚呼！人之心多不平也"],"answerIndex":1,"image":null},{"id":"097","type":0,"prompt":"為學一首示子姪一文的主旨與下列何者相近？","choices":["有志者事竟成","放下屠刀，立地成佛","死生有命，富貴在天","巧婦難為無米之炊"],"answerIndex":0,"image":null},{"id":"098","type":0,"prompt":"「凡是轉彎的地方都危險，不論陸地或水上」這句話帶有何種語氣？","choices":["叮嚀","命令","告誡","懇求"],"answerIndex":0,"image":null},{"id":"099","type":0,"prompt":"下列哪一個解釋錯誤？","choices":["「離離」散紅：分離","塵務：世俗的事務","僮僕：未滿二十歲的僕役","悠然：閒適自得的樣子"],"answerIndex":0,"image":null},{"id":"100","type":0,"prompt":"「紅花綠葉」的「紅」、「綠」兩字，跟下列哪一句「」中的字詞性相同？","choices":["「良」辰「美」景","「山」明「水」秀","「欺」善「怕」惡","「絕」無「僅」有"],"answerIndex":0,"image":null},{"id":"101","type":0,"prompt":"「不自限其昏與庸而力學不倦，自立者也」一句，顯露何種語氣？","choices":["肯定","推測","叮嚀","感嘆"],"answerIndex":0,"image":null},{"id":"102","type":0,"prompt":"「吾資之昏，不逮人也」句中「不逮人也」的意思為何？","choices":["不知別人的程度","不要和別人相比","不比別人愚笨","比不上別人聰明"],"answerIndex":3,"image":null},{"id":"103","type":0,"prompt":"凡是用來連接兩個以上的詞、句子，甚至段落的詞，叫做什麼？","choices":["介詞","連詞","助詞","嘆詞"],"answerIndex":1,"image":null},{"id":"104","type":0,"prompt":"「防患未然／防微杜漸」之間的關係與下列哪一組相同？","choices":["晴晝晚陰／朝暉夕陰","杯水車薪／大有助益","無稽之談／言之鑿鑿","悠然自得／提心吊膽"],"answerIndex":0,"image":null},{"id":"105","type":0,"prompt":"下列哪一句最能表現出溫馨的氣氛？","choices":["僮僕漸睡，內外寂然","紅燭溫爐，手注佳茗","異書在案，朱墨爛然","精神不繼，塵務經心"],"answerIndex":1,"image":null},{"id":"106","type":0,"prompt":"下列哪一個成語，不能用來形容「旦旦而學之，久而不怠焉」的學習態度？","choices":["焚膏繼晷","奔走逢迎","枕經藉史","韋編三絕"],"answerIndex":1,"image":null},{"id":"107","type":0,"prompt":"守護灣潭的燈一文，根據全文脈絡來看，「燈」指的是什麼？","choices":["在灣潭岸邊的路燈","寫出灣潭故事的作者自己","灣潭未來的發展方向","住在灣潭邊的老夫婦"],"answerIndex":3,"image":null},{"id":"108","type":0,"prompt":"越縵堂日記選中，作者所謂的「三友」是指什麼？","choices":["松、竹、梅","友直、友諒、友多聞","梅、蘭、菊","紫豆、芭蕉、紫薇"],"answerIndex":3,"image":null},{"id":"109","type":0,"prompt":"「虛懷若谷」的「虛」字，字義同於下列何者？","choices":["彈無「虛」發","「虛」心受教","「虛」位以待","作賊心「虛」"],"answerIndex":1,"image":null},{"id":"110","type":0,"prompt":"下列各組字形相近的字，何者讀音前後相同？","choices":["「籌」畫／「壽」命","「拘」執／「苟」且","「磨」練／「摩」天大樓","「蘊」藉／「溫」度"],"answerIndex":2,"image":null},{"id":"111","type":0,"prompt":"下列何項不是馬克．吐溫在湯姆歷險記中所塑造的湯姆形象？","choices":["熱愛自由","老謀深算","腦筋靈活","調皮好玩"],"answerIndex":1,"image":null},{"id":"112","type":0,"prompt":"「使他不要以願望代替實際作為」，這是麥克阿瑟希望兒子做事如何？","choices":["一帆風順","空口大話","腳踏實地","人生有夢"],"answerIndex":2,"image":null},{"id":"113","type":0,"prompt":"「嘲笑」之於「揶揄」，相當於「回祿」之於下列何者？","choices":["喬梓","戎馬","祝融","巾幗"],"answerIndex":2,"image":null},{"id":"114","type":0,"prompt":"下列「」中的用字，何者錯誤？","choices":["脫口而出","綠意盎然","慢不經心","品頭論足"],"answerIndex":2,"image":null},{"id":"115","type":0,"prompt":"「對未來善加籌畫，但是永不忘記過去」一句的含義與下列何者相同？","choices":["勇往直前，努力不懈","檢討過去，策勵未來","積極進取，認真負責","大智若愚，深藏不露"],"answerIndex":1,"image":null},{"id":"116","type":0,"prompt":"臺灣俗諺：「摸蛤仔兼洗褲」，這句話是什麼意思？","choices":["一舉兩得","看不出來","白費工夫","假仙"],"answerIndex":0,"image":null},{"id":"117","type":0,"prompt":"由兩個音節組成而不能分割的雙音詞稱為「聯綿詞」，下列何者不是聯綿詞？","choices":["葡萄","學生","躊躇","蜻蜓"],"answerIndex":1,"image":null},{"id":"118","type":0,"prompt":"詞可以分為「實詞」和「虛詞」兩大類，下列哪一項全部為「虛詞」？","choices":["在、哇、也","你、和、他","蓋、耳、以","說、前、提"],"answerIndex":0,"image":null},{"id":"119","type":0,"prompt":"雙聲關係是指詞彙中的聲母相同下列何者屬於「雙聲關係」？","choices":["迴繞","藩籬","徜徉","開墾"],"answerIndex":3,"image":null},{"id":"120","type":0,"prompt":"下列選項中的文句，何者句型與「交友是一件很有意義的事」不同？","choices":["微笑是世界上共通的語言","良心是心靈的紀律","世界是一本大書","你還是早點回家吧"],"answerIndex":3,"image":null},{"id":"121","type":0,"prompt":"下列各成語，何者結構中具有虛詞？","choices":["處之泰然","語重心長","深謀遠慮","張牙舞爪"],"answerIndex":0,"image":null},{"id":"122","type":0,"prompt":"「宗教團體不斷以物資救助災民貧困的生活」這句話的動詞為何？","choices":["不斷","救助","貧困","生活"],"answerIndex":1,"image":null},{"id":"123","type":0,"prompt":"下列「」中的字，何者不當動詞用？","choices":["紫薇久「花」","作「花」甚繁","塵務「經」心","「風」葉露穗"],"answerIndex":1,"image":null},{"id":"124","type":0,"prompt":"「品頭論足」的詞性結構同於下列何者？","choices":["頭暈目眩","海誓山盟","厲兵秣馬","天長地久"],"answerIndex":2,"image":null},{"id":"125","type":0,"prompt":"凡是能夠對動詞的動作或形容詞的性質、狀態給予修飾、限制的詞，稱為什麼？","choices":["名詞","數量詞","副詞","介詞"],"answerIndex":2,"image":null},{"id":"126","type":0,"prompt":"下列各選項「」中的數字，何者具有實際意義？","choices":["接「二」連三","推「三」阻四","「一」刀兩斷","「五」里霧中"],"answerIndex":2,"image":null},{"id":"127","type":0,"prompt":"下列何者是「有無句」？","choices":["交友是一件有益的事","沒有人喜歡他","公說公有理","人與人偶有摩擦"],"answerIndex":3,"image":null},{"id":"128","type":0,"prompt":"「漁者得而并禽之」這句話未用到哪一個詞性？","choices":["動詞","連詞","代詞","介詞"],"answerIndex":3,"image":null},{"id":"129","type":0,"prompt":"下列「」中的量詞，何者使用不恰當？","choices":["一「枝」鉛筆","一「頓」飯","一「幅」對聯","一「張」紙"],"answerIndex":2,"image":null},{"id":"130","type":0,"prompt":"麥帥為子祈禱文中所謂「知識的基石」指的是什麼？","choices":["誠實","純潔","自知","勇敢"],"answerIndex":2,"image":null},{"id":"131","type":0,"prompt":"若依形式來看，則麥帥為子祈禱文應屬於哪一種文體？","choices":["論說文","抒情文","應用文","記敘文"],"answerIndex":2,"image":null},{"id":"132","type":0,"prompt":"「平安就是福」是「主語＋繫語＋斷語」的句型，下列何者與此相同？","choices":["實事求是","馬首是瞻","空即是色","各行其是"],"answerIndex":2,"image":null},{"id":"133","type":0,"prompt":"下列何者的音韻關係與「蜿蜒」相同，屬於疊韻關係？","choices":["嘹亮","徜徉","彷彿","閃爍"],"answerIndex":1,"image":null},{"id":"134","type":0,"prompt":"下列各句「」中的字，何者詞性異於其他三者？","choices":["溪流消「匿」","汗流「浹」背","橫「陳」屏阻","「閒」置岸邊"],"answerIndex":3,"image":null},{"id":"135","type":0,"prompt":"「複製牛姐妹，在生技展中亮相」句中的「在」是屬於哪一種詞性？","choices":["介詞","連詞","助詞","嘆詞"],"answerIndex":0,"image":null},{"id":"136","type":0,"prompt":"下列「」中的字，何者當連詞用？","choices":["天仙「或」白馬王子","他來「自」美國","兩「派」畫家的畫風","他「坐」在椅子上"],"answerIndex":0,"image":null},{"id":"137","type":0,"prompt":"「慈烏失其母」的結構是「主語＋述語＋賓語」下列何句的結構與此相同？","choices":["下雨天真好","刨冰的種類繁多","我望著母親的臉","老師的打扮很時髦"],"answerIndex":2,"image":null},{"id":"138","type":0,"prompt":"下列詞語，何者分開後皆可單獨成詞表義？","choices":["彷彿","叮嚀","徜徉","俯仰"],"answerIndex":3,"image":null},{"id":"139","type":0,"prompt":"為學一首示子姪一文的主旨為下列何者？","choices":["人盡其才","因時制宜","以柔克剛","力學不倦"],"answerIndex":3,"image":null},{"id":"140","type":0,"prompt":"「駕馭、畏懼、祈禱、謙遜」以上共有幾個同義複詞？","choices":["四個","三個","二個","一個"],"answerIndex":0,"image":null},{"id":"141","type":0,"prompt":"下列「」中的字，何者與其他三者意思不同？","choices":["閒情逸「致」","興「致」高昂","一夜「致」富","婉轉有「致」"],"answerIndex":2,"image":null},{"id":"142","type":0,"prompt":"下列「」中的字，何組讀音相同？","choices":["「行」家／品「行」","「行」為／商「行」","航「行」／外「行」","送「行」／運「行」"],"answerIndex":3,"image":null},{"id":"143","type":0,"prompt":"下列各成語的意義，何者異於其他三者？","choices":["持盈守虛","虛懷若谷","撫躬自問","謙沖自牧"],"answerIndex":2,"image":null},{"id":"144","type":0,"prompt":"下列「」中的形似字，何組讀音相同？","choices":["「揣」度／「湍」急","山「巒」／「鸞」鳳","「翡」翠／門「扉」","「掠」過／「晾」衣"],"answerIndex":1,"image":null},{"id":"145","type":0,"prompt":"「真實力量的溫和蘊藉」意味著什麼？","choices":["暴虎馮河","有勇無謀","謀定後動","寧靜致遠"],"answerIndex":3,"image":null},{"id":"146","type":0,"prompt":"下列各選項的字詞，何者沒有形聲字？","choices":["心甘情願","月落烏啼","囫圇吞棗","日出東山"],"answerIndex":3,"image":null},{"id":"147","type":0,"prompt":"有一位老婆婆拿慢車的車票卻坐上了快車，她應該怎麼跟司機說，最有幽默感？","choices":["那我去重買一張車票","那你開慢一點不就好了","那我去改搭另一班車","我是老人，不能通融一下嗎"],"answerIndex":1,"image":null},{"id":"148","type":0,"prompt":"越縵堂日記選一文中，「此事固當有福」的「有福」回應了哪一句話？","choices":["僮僕漸睡，內外寂然","此間受用正復不盡","精神不繼，塵務經心","不能領略"],"answerIndex":1,"image":null},{"id":"149","type":0,"prompt":"「農夫在草堆中□□發現一個老舊的箱子」缺空中的詞語宜填入下列何者？","choices":["毅然","爛然","淡然","赫然"],"answerIndex":3,"image":null},{"id":"150","type":0,"prompt":"下列各組詞語，何者用字完全正確？","choices":["力有未逮","暗劍傷人","破斧沉舟","悲痛欲覺"],"answerIndex":0,"image":null},{"id":"151","type":0,"prompt":"「輕盈、頂針、嘲笑、引擎、鈴噹、乏味」，上述有幾個疊韻關係詞？","choices":["二個","三個","四個","五個"],"answerIndex":0,"image":null},{"id":"152","type":0,"prompt":"下列各選項「」中的單位詞，何者使用正確？","choices":["一「顆」椰子樹","一「艘」鐵板船","一「副」風景畫","一「輪」新月"],"answerIndex":1,"image":null},{"id":"153","type":0,"prompt":"下列「」中的詞語，何者是偏義複詞？","choices":["天下事有「難易」乎","卻不見孔明「動靜」","「遠近」高低各不同","不以「成敗」論英雄"],"answerIndex":1,"image":null},{"id":"154","type":0,"prompt":"越縵堂日記選一文中，「悠然暢寄，書味滿胸」二句是描述何種情趣？","choices":["庭中徙倚之樂","郊外徘徊之樂","深夜讀書之樂","完成著作之樂"],"answerIndex":1,"image":null},{"id":"155","type":0,"prompt":"「每晴晝晚陰，徙倚其下」句中的「徙倚」不可用何詞替換？","choices":["俯仰","躑躅","流連","徘徊"],"answerIndex":0,"image":null},{"id":"156","type":0,"prompt":"下列何者與「運筆」無關？","choices":["搖櫓","勾勒","素描","揮毫"],"answerIndex":0,"image":null},{"id":"157","type":0,"prompt":"下列何者不是介詞？","choices":["天仙「或」白馬王子","「從」頭到腳都是新的","他來「自」高雄","徐噴「以」煙"],"answerIndex":0,"image":null},{"id":"158","type":0,"prompt":"下列各選項中的數量詞，何者使用錯誤？","choices":["一「方」手帕","一「副」畫像","一「葉」扁舟","一「瓶」啤酒"],"answerIndex":1,"image":null},{"id":"159","type":0,"prompt":"當作者黃昏時獨坐灣潭，因為感受到周遭的沉靜，而有何種感覺？","choices":["遺世獨立","閒情逸致","閒雲野鶴","神凝意定"],"answerIndex":0,"image":null},{"id":"160","type":0,"prompt":"下列各組詞語，何者為近義關係？","choices":["造詣深厚／腹笥甚窘","刻苦自勵／玩日愒歲","從容不迫／泰然自若","自以為是／從善如流"],"answerIndex":2,"image":null},{"id":"161","type":0,"prompt":"下列選項中，何者全部都是外來語音譯的詞？","choices":["幽默、邏輯、壽司","動畫、冰箱、吹牛","番茄、胡琴、公車","銀幕、干戈、孔方"],"answerIndex":0,"image":null},{"id":"162","type":0,"prompt":"下列「」中的字，何者不是助詞？","choices":["「為」何沒有什麼遊人","這是你的「嗎」","「蓋」一癩蝦蟆也","大去之期不遠「矣」"],"answerIndex":0,"image":null},{"id":"163","type":0,"prompt":"下列文句，何者句型和「今夜星光燦爛」相同？","choices":["霓虹燈點亮了街道","月亮是一個白玉盤","無數小路蜿蜓著","兒童笑容盈盈"],"answerIndex":3,"image":null},{"id":"164","type":0,"prompt":"下列各組詞語「」中的字，拿掉部首後的讀音，何者和原字相同？","choices":["紫「薇」","「傾」聽","稻「穗」","「簇」擁"],"answerIndex":0,"image":null},{"id":"165","type":0,"prompt":"下列何者和「我對孩子眨眨眼睛認真的說」一句的句型相同？","choices":["天使為什麼要守著小孩呢","天使是悲傷的嗎","這種守望的天使是飛不遠的","你真的有兩個這樣的天使"],"answerIndex":0,"image":null},{"id":"166","type":0,"prompt":"下列各組詞語，何者用字錯誤？","choices":["風聲鶴戾／暴戾不安","蜿蜒曲折／婉轉有致","簡樸生活／忠實僕人","作家手稿／搞笑天王"],"answerIndex":0,"image":null},{"id":"167","type":0,"prompt":"下列各選項「」中的詞語，何者是該句主語？","choices":["貧者語於「富者」","越「明年」，貧者自南海還","「蜀之鄙」有二僧","「天下」事有難易乎"],"answerIndex":2,"image":null},{"id":"168","type":0,"prompt":"下列句型，何者與「兒女眾多」相同？","choices":["手捧寶劍","四顧無人","書味滿胸","山川壯麗"],"answerIndex":3,"image":null},{"id":"169","type":0,"prompt":"「驕傲可使我們離開真理，終於毀滅」與此同弊的是下列何者？","choices":["自視非凡，過於拘執","畏首畏尾，裹足不前","寧鳴而死，不默而生","逸豫亡身，殷憂啟聖"],"answerIndex":0,"image":null},{"id":"170","type":0,"prompt":"下列何者不是同義複詞？","choices":["藩籬","斜切","販賣","燃燒"],"answerIndex":1,"image":null},{"id":"171","type":0,"prompt":"下列各組詞語「」中的字，何者詞性異於其他三者？","choices":["內外「寂」然","手注佳「茗」","書味滿「胸」","山外煙「嵐」"],"answerIndex":0,"image":null},{"id":"172","type":0,"prompt":"依據湯姆歷險記一文，看不出湯姆有下列哪一種個性？","choices":["善良膽小","調皮好玩","腦筋靈活","充滿創意"],"answerIndex":0,"image":null},{"id":"173","type":0,"prompt":"下列詞語，何者不是自稱詞？","choices":["吾","余","子","在下"],"answerIndex":2,"image":null},{"id":"174","type":0,"prompt":"臺灣俗諺：「一枝草，一點露」是什麼意思？","choices":["一舉兩得","天無絕人之路","白費工夫","假仙"],"answerIndex":1,"image":null},{"id":"175","type":0,"prompt":"「留蚊於素帳中」此句話中不能獨立表達具體概念的是哪一個字？","choices":["蚊","中","於","留"],"answerIndex":2,"image":null},{"id":"176","type":0,"prompt":"「吾一瓶一缽足矣」中的「一」字是實數，下列何者也當實數解？","choices":["專「一」不變","大小不「一」","「一」身是膽","不易「一」字"],"answerIndex":3,"image":null},{"id":"177","type":0,"prompt":"麥克阿瑟認為要想保持嚴肅的態度，而又不過分拘執，應該要如何？","choices":["心地純潔","培養幽默感","謙遜溫和","儉以養廉"],"answerIndex":1,"image":null},{"id":"178","type":0,"prompt":"下列「」中的字詞，哪一個在句中的作用與其他不同？","choices":["他「是」個高大的人","他的身材「很」高大","他「有」高大的身軀","他「長」成高大的體魄"],"answerIndex":1,"image":null},{"id":"179","type":0,"prompt":"下列何者不是智者的表現？","choices":["謙沖自牧","不恥下問","鋒芒畢露","謀定後動"],"answerIndex":2,"image":null},{"id":"180","type":0,"prompt":"「電腦逐漸成為現代人的生活必需品」，這句話中的「逐漸」詞性為何？","choices":["名詞","形容詞","副詞","動詞"],"answerIndex":2,"image":null},{"id":"181","type":0,"prompt":"下列各選項的詞語，何者聲韻關係和「非凡」相同？","choices":["高超","堅決","窈窕","呻吟"],"answerIndex":1,"image":null},{"id":"182","type":0,"prompt":"「突然聽到老師生病住院的消息，班上一陣□□」空格中宜填入哪一個詞語？","choices":["油然","忿然","渾然","譁然"],"answerIndex":3,"image":null},{"id":"183","type":0,"prompt":"下列哪一組的字可以獨立成詞？","choices":["遇、缺","躇、蜓","蝴、徬","瓏、蜘"],"answerIndex":0,"image":null},{"id":"184","type":0,"prompt":"下列哪一本書不能讓我們了解美國的文化、生活？","choices":["湯姆歷險記","飄","哈利波特","小婦人"],"answerIndex":2,"image":null},{"id":"185","type":0,"prompt":"「其劍自舟中墜於水」的「自」字，詞性同於下列何者？","choices":["舟","墜","於","水"],"answerIndex":2,"image":null},{"id":"186","type":0,"prompt":"湯姆寫信給波莉阿姨，在信件最後，他應如何自稱？","choices":["姪子","外甥","小犬","愚弟"],"answerIndex":1,"image":null},{"id":"187","type":0,"prompt":"下列各組形似字，何者讀音相同？","choices":["哺／逋","嗟／搓","遺／遣","胸／洶"],"answerIndex":3,"image":null},{"id":"188","type":0,"prompt":"「在獲得成功之際，能夠謙遜而溫和」這句話的意思同於下列何者？","choices":["百尺竿頭，更進一步","坐這山，望那山","勝固欣然，敗亦可喜","勝而不驕"],"answerIndex":3,"image":null},{"id":"189","type":0,"prompt":"有關「壑」字的用法，下列何者錯誤？","choices":["穿梭谷壑","欲深谿壑","以鄰為壑","壑然開朗"],"answerIndex":3,"image":null},{"id":"190","type":0,"prompt":"下列選項「」中的字，何組讀音不同？","choices":["校「勘」／「戡」亂","中「輟」生／點「綴」","右「舷」／琴「絃」","「漫」畫／「謾」罵"],"answerIndex":1,"image":null},{"id":"191","type":0,"prompt":"下列「」中的字，何者不是副詞？","choices":["「白」米","「暗」笑","「瞎」扯","「長」征"],"answerIndex":0,"image":null},{"id":"192","type":0,"prompt":"下列哪一部戲的名稱是可以完整表意的「句子」？","choices":["綠光森林","惡作劇之吻","浪漫滿屋","草山春暉"],"answerIndex":2,"image":null},{"id":"193","type":0,"prompt":"在守護灣潭的燈一文的作者眼中，老夫婦對灣潭的意義，就像下列何組的關係？","choices":["甘泉之於荒漠","燈塔之於海港","長官之於部屬","老師之於學生"],"answerIndex":1,"image":null},{"id":"194","type":0,"prompt":"美國詩人愛默生：「不要在懷疑與恐懼中浪費生命」這句話在勉勵人應該如何？","choices":["謙遜待人","堅定自信","誠實不欺","幽默風趣"],"answerIndex":1,"image":null},{"id":"195","type":0,"prompt":"「追求人生幸福」是省略「主語」的敘事句，下列文句，何者也省略了主語？","choices":["人生如夢","陽光燦爛","眼神銳利","小心火燭"],"answerIndex":3,"image":null},{"id":"196","type":0,"prompt":"「漫不經心」的「漫」字，其字義同於下列何者？","choices":["「漫」山遍野","「漫」無止盡","生性浪「漫」","「漫」卷詩書"],"answerIndex":2,"image":null},{"id":"197","type":0,"prompt":"下列形近字的讀音，何者不同？","choices":["端／湍／顓","謳／毆／歐","槁／縞／稿","雍／臃／壅"],"answerIndex":0,"image":null},{"id":"198","type":0,"prompt":"由守護灣潭的燈一文中可知，作者所嚮往的是什麼樣的生活？","choices":["積極奮鬥","平靜閒適","無所事事","熱心助人"],"answerIndex":1,"image":null},{"id":"199","type":0,"prompt":"下列何者是「有無句」？","choices":["有恆為成功之本","草木嬌小玲瓏","天涯何處無芳草","我愛吹口哨"],"answerIndex":2,"image":null},{"id":"200","type":0,"prompt":"「李小輝畢生鑽研農業品種改良，是這行的□□」以上空格處不宜填入何者？","choices":["行家","翹楚","權威","高足"],"answerIndex":3,"image":null},{"id":"201","type":0,"prompt":"「精神不繼」可以用下列何詞替換？","choices":["生氣蓬勃","憔悴不堪","生意盎然","朝氣蓬勃"],"answerIndex":1,"image":null},{"id":"202","type":0,"prompt":"下列各組詞語，何者音韻關係皆相同？","choices":["忐忑、嘹亮、錦江","鄙夷、偏僻、憑藉","狼藉、著墨、愚昧","懈怠、埋怨、參差"],"answerIndex":0,"image":null},{"id":"203","type":0,"prompt":"「為子祈禱」的「為」，字義同於下列何者？","choices":["「為」人所景仰","「為」正義而發聲","「為」人作嫁","「為」何不答應"],"answerIndex":2,"image":null},{"id":"204","type":0,"prompt":"「我非常喜歡朗誦詩歌」這句話中不包含哪一類實詞？","choices":["副詞","數量詞","名詞","動詞"],"answerIndex":1,"image":null},{"id":"205","type":0,"prompt":"「雞犬相聞」一句，依詞性依序為何？","choices":["名詞、名詞、副詞、動詞","名詞、名詞、形容詞、副詞","代詞、形容詞、副詞、助詞","名詞、代詞、形容詞、動詞"],"answerIndex":0,"image":null},{"id":"206","type":0,"prompt":"「哇！天氣竟然這麼冷」的「哇」詞性為何？","choices":["介詞","連詞","助詞","嘆詞"],"answerIndex":3,"image":null},{"id":"207","type":0,"prompt":"越縵堂日記選一文中，「異書在案」的心境，與下列何者相似？","choices":["晝長吟罷蟬鳴樹","三日不讀書，便覺面目可憎","腹有詩書氣自華","可以調素琴，閱金經"],"answerIndex":3,"image":null},{"id":"208","type":0,"prompt":"下列哪一句最能表現出作者與花木相親的景況？","choices":["遠近接簇，悠然暢寄","芭蕉展葉，綠滿窗戶","每晴晝晚陰，徙倚其下","紫豆一叢，作花甚繁"],"answerIndex":2,"image":null},{"id":"209","type":0,"prompt":"「兼可入道」中，「兼」字的意思為何？","choices":["得","顧及","又","勝"],"answerIndex":2,"image":null},{"id":"210","type":0,"prompt":"縱觀麥帥為子祈禱文，若以一言來貫穿通篇章旨，則應是下列何者？","choices":["志堅氣柔","夙夜匪懈","自立自強","放眼天下"],"answerIndex":2,"image":null},{"id":"211","type":0,"prompt":"下列何者的詞語結構與其他三者不同？","choices":["呼朋引伴","聚沙成塔","冷嘲熱諷","幸災樂禍"],"answerIndex":2,"image":null},{"id":"212","type":0,"prompt":"「老鼠鑽進書櫃裡」猜一句成語？","choices":["恃才傲物","如沐春風","咬文嚼字","櫛比鱗次"],"answerIndex":2,"image":null},{"id":"213","type":0,"prompt":"下列各成語中，何者結構中有介詞？","choices":["論功行賞","迫在眉睫","一字千金","金屋藏嬌"],"answerIndex":1,"image":null},{"id":"214","type":0,"prompt":"下列各詞語，何者用字完全正確？","choices":["雍人自擾","毆心瀝血","反躬自省","副可敵國"],"answerIndex":2,"image":null},{"id":"215","type":0,"prompt":"「幽默」一詞是英文的音譯，下列哪一組詞語，全是由外來語音譯而成？","choices":["汽水、巴士、巧克力","漢堡、咖啡、冬瓜茶","拷貝、沙拉、三明治","夾克、鳳梨、白蘭地"],"answerIndex":2,"image":null},{"id":"216","type":0,"prompt":"同義複詞是指上下兩個詞語意思都相同，下列哪一組皆屬同義複詞？","choices":["櫥窗／哄堂","跳躍／墜落","美麗／定理","姑且／昔日"],"answerIndex":1,"image":null},{"id":"217","type":0,"prompt":"下列「」中的疊字詞，何者不是狀聲詞？","choices":["「琅琅」上口","流水「潺潺」","大汗「涔涔」","「呱呱」墜地"],"answerIndex":2,"image":null},{"id":"218","type":0,"prompt":"下列哪一句最能看出李慈銘讀書至勤的情形？","choices":["正復不盡","朱墨爛然","內外寂然","異書在案"],"answerIndex":1,"image":null},{"id":"219","type":0,"prompt":"下列何者用字完全正確？","choices":["一「儔」莫展","陶「禱」品格","事先「擣」畫","「鑄」下大錯"],"answerIndex":3,"image":null},{"id":"220","type":0,"prompt":"下列哪一句所表達的意思和其他三者不相似？","choices":["誰說這是一齣好戲呢","這種的算是好戲嗎","這哪稱得上好戲","誰說這不是一齣好戲呢"],"answerIndex":3,"image":null},{"id":"221","type":0,"prompt":"以下嘆詞，何者使用不恰當？","choices":["啊！這布料好像棋盤似的","哇！你表演得很好","哼！天氣好冷呀","唉呀！牠完全不能動了"],"answerIndex":2,"image":null},{"id":"222","type":0,"prompt":"下列「」中的詞語，哪一個不屬於虛詞？","choices":["送孟浩然「之」廣陵","「雖然」我的手不再美麗","主義「是」從","「啊」！好像棋盤似的"],"answerIndex":0,"image":null},{"id":"223","type":0,"prompt":"形容詞可以用來修飾名詞，下列「」中的詞語，何者不是這種用法？","choices":["「深」入「淺」出","滾著「火」輪子","藍天「白」雲","「涼爽」的夏夜"],"answerIndex":0,"image":null},{"id":"224","type":0,"prompt":"為學一首示子姪一文的寫作特色，不包括下列何者？","choices":["層次井然","舉例貼切","故事懸疑","對比分明"],"answerIndex":2,"image":null},{"id":"225","type":0,"prompt":"由「朱墨爛然」一句，可知作者讀書時如何？","choices":["愛用紅筆描摹書中文字","隨手塗鴉，不珍惜書本","專心研究書中義理","樂在批評書中言論"],"answerIndex":2,"image":null},{"id":"226","type":0,"prompt":"下列哪一文句最具動態之美？","choices":["夕陽在山，蒼翠欲滴","風葉露穗，搖蕩若千頃波","悠然暢寄，書味滿胸","獨步至倉頡祠前看稻花"],"answerIndex":1,"image":null},{"id":"227","type":0,"prompt":"下列成語，何者用字錯誤？","choices":["箭在弦上，不得不發","尺有所短，寸有所長","愈加之罪，何患無詞","兔死狐悲，物傷其類"],"answerIndex":2,"image":null},{"id":"228","type":0,"prompt":"雙聲關係是指上下兩個字的聲母都是相同的，下列哪一組都是屬於雙聲關係？","choices":["粗糙／參差","逍遙／朦朧","藤蔓／聆聽","軒輊／山上"],"answerIndex":0,"image":null},{"id":"229","type":0,"prompt":"「我愛鳥」屬於敘事句，下列各句何者也屬於此類？","choices":["庭中有奇樹","慈烏失其母","百鳥豈無母","應是母慈重"],"answerIndex":1,"image":null},{"id":"230","type":0,"prompt":"「天下為公」是判斷句，下列何者不是判斷句？","choices":["民為邦本","言為心聲","士為知己者死","有恆為成功之本"],"answerIndex":2,"image":null},{"id":"231","type":0,"prompt":"下列文句，何者是敘事句？","choices":["天下事有難易乎","蜀之鄙有二僧","富者有慚色","吾欲之南海"],"answerIndex":3,"image":null},{"id":"232","type":0,"prompt":"下列各選項的詞語結構，何者和「心想事成」相同？","choices":["山明水秀","長篇大論","紅花綠葉","夫唱婦隨"],"answerIndex":3,"image":null},{"id":"233","type":0,"prompt":"下列「」中的詞語經替換後，何者意義改變？","choices":["「應該」如此應","「徘徊」不去徊","「耽誤」了行程誤","「屏棄」而不用棄"],"answerIndex":1,"image":null},{"id":"234","type":0,"prompt":"「風葉露穗」的詞性結構與下列何者相同？","choices":["春花秋月","海闊天空","冰天雪地","飲水思源"],"answerIndex":3,"image":null},{"id":"235","type":0,"prompt":"「對未來善加籌畫，但是永不忘記過去」這句話的意思與下列何者最為接近？","choices":["十年河東，十年河西","前事不忘，後事之師","福無雙至，禍不單行","人無遠慮，必有近憂"],"answerIndex":1,"image":null},{"id":"236","type":0,"prompt":"下列成語，何者符合「主語＋表語」的結構？","choices":["四海一家","胸有成竹","人盡其才","史無前例"],"answerIndex":0,"image":null},{"id":"237","type":0,"prompt":"下列「」中字的詞性，何者不當動詞？","choices":["塵務「經」心","「紅」燭溫爐","芭蕉「展」葉","離離「散」紅"],"answerIndex":1,"image":null},{"id":"238","type":0,"prompt":"「庭中紫豆一叢，作花甚繁」句中的「繁」字，與下列何字意義相通？","choices":["藩","蕃","煩","墦"],"answerIndex":1,"image":null},{"id":"239","type":0,"prompt":"「每晴晝晚陰，徙倚其下」句中的「徙倚」意思為下列何者？","choices":["徘徊","佇立","依靠","俯仰"],"answerIndex":0,"image":null},{"id":"240","type":0,"prompt":"下列詞語結構，何者與「閒雲野鶴」相同？","choices":["開門見山","拖泥帶水","閒情逸致","天搖地動"],"answerIndex":2,"image":null},{"id":"241","type":0,"prompt":"麥克阿瑟說：「讓他藉此學習對失敗的人加以同情」是希望他的兒子怎麼樣？","choices":["訓練演戲天分","爭取別人認同","培養崇高人格","預演失敗場面"],"answerIndex":2,"image":null},{"id":"242","type":0,"prompt":"下列何者適合用來形容守護灣潭的燈一文之特色？","choices":["慷慨激昂","幽默詼諧","沉重悲傷","意味深長"],"answerIndex":3,"image":null},{"id":"243","type":0,"prompt":"下列詞語的構成方式，何者與「閒雲野鶴」相同？","choices":["拖泥帶水","青梅竹馬","神凝意定","任重道遠"],"answerIndex":1,"image":null},{"id":"244","type":0,"prompt":"「為子祈禱」的「為」字，意思與下列何者相同？",